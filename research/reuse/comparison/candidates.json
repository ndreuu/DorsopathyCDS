      "id": "mne",
      "name": "MNE-Python",
      "kind": "Python library",
      "decision": "Conditional alignment adapter",
      "checked_docs_version": "1.13.2",
      "repository": "https://github.com/mne-tools/mne-python",
      "license": "BSD-3-Clause",
