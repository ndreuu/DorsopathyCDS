        "Raw.resample(sfreq, events=events)",
        "mne.Annotations(onset, duration, description, orig_time=None)"
      ],
      "input_shape": {
        "data": "channels x samples; calibrated MNE channel units",
        "shared_events": "Equal-length arrays, seconds from each Raw start",
        "provenance": "Source hashes, original sample indices and verified event correspondence"
      },
      "output": "In-place cropped/resampled Raw objects with adjusted annotations; no complete audit-sidecar",
      "gates": [
        "Verified same subject/session and simultaneous acquisition",
        "Regular sampling or explicit dropout profile",
        "Distributed verified synchronization events",
        "Independent residual/uncertainty within protocol tolerance"
      ],
      "limitations": [
        "Offset plus first-order drift model",
        "Call on copies; both Raw objects can be cropped",
        "MNE warns for fewer than 20 event times; warning is not clinical validation",
        "Retain original events because resampling affects timing",
        "Waveform correlation does not prove clock sync",
        "Adapter must preserve mapping and original selectors"
      ],
      "sources": [
        "https://mne.tools/stable/generated/mne.preprocessing.realign_raw.html",
